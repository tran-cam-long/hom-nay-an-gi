{
  "name": "hom-nay-an-gi",
  "version": "0.1.0",
  "private": true,
  "description": "POI aggregator + frontend demo",
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently \"yarn start:server\" \"yarn start:frontend\"",
    "start:server": "yarn --cwd server start:dev",
    "start:frontend": "yarn --cwd frontend dev",
    "install:frontend": "echo 'No build; open frontend/index.html'"
  },
  "packageManager": "yarn@1.22.19",
  "dependencies": {
    "dotenv": "^16.0.0",
    "node-fetch": "^2.6.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
